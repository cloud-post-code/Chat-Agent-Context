# ---- Copy to .env and fill in. Every variable the code reads is listed. ----

# Postgres connection string (the only supported database; migrations are
# Postgres SQL). Railway injects it automatically.
DATABASE_URL="postgresql://postgres:pw@localhost:5433/chatagent_dev?schema=public"

# Anthropic Claude API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Which Claude model the chatbot, summarizers, extractors and vision use.
CLAUDE_MODEL="claude-haiku-4-5-20251001"
# Model for the admin card builder only (needs adaptive thinking; falls back to CLAUDE_MODEL).
CARD_BUILDER_MODEL=""

# The FOUNDING account. On the first boot the migration-created founder is
# claimed with these; log in at /admin. Everyone else signs up at /signup.
# ADMIN_PASSWORD also works as an A2A bearer token.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Signs the admin session cookie. A long random string.
AUTH_SECRET=""
# Accounts allowed into the operator-only tabs (Users, Bulk builder):
# comma-separated emails. Unset, only the founder is an operator.
OPERATOR_EMAILS=""
# Password that unlocks editing an ingestion source's config at
# /admin/sources/<key>. Falls back to ADMIN_PASSWORD.
INGESTION_EDIT_PASSWORD=""

# Where uploaded images are written. Local: ./data/uploads.
# Railway: mount a volume at /data and set /data/uploads.
UPLOAD_DIR="./data/uploads"
# Public base URL. REQUIRED for A2A: it is the URL the Agent Card advertises.
# Unset, the card falls back to the incoming request's host.
NEXT_PUBLIC_SITE_URL=""

# ---- A2A (agent-to-agent) ----
# Every call must send `Authorization: Bearer <token>` matching this key or
# ADMIN_PASSWORD. If neither is set the endpoint refuses everyone.
A2A_API_KEY=""
# Accepted calls per caller IP per minute (each spends model credits). 0 disables.
A2A_RATE_LIMIT="30"

# ---- Retrieval ----
# Embeddings: VOYAGE_API_KEY → voyage-3.5-lite; else OPENAI_API_KEY →
# text-embedding-3-small; else a local hashed embedder (no network).
VOYAGE_API_KEY=""
# Also image generation for the card builder (gpt-image-1). Unset, the
# builder reuses existing images only.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
# Pause between origins in `scripts/reindex.ts --all` (default 21000 ms) and,
# when set, in onboarding's indexing.
EMBED_PACE_MS=""

# ---- Onboarding and background work ----
# Extraction agents running at once while onboarding reads a site (default 4, max 12).
ONBOARDING_CONCURRENCY="4"
# Sites built at once by the operator's Bulk builder.
BULK_BUILD_CONCURRENCY=""
# Time budgets (ms) for the model calls that draft canned answers and starter questions (default 12000).
DRAFT_DEADLINE_MS=""
STARTER_QUESTIONS_DEADLINE_MS=""
# Set to log the gallery curator's raw model output.
DEBUG_GALLERY=""

# ---- Gmail (Contacts from sent mail) ----
# OAuth client for /api/admin/gmail/connect. Unset, the Connect button is hidden.
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""

# ---- Analytics ----
# PostHog. Both public (NEXT_PUBLIC_). Blank key disables analytics.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---- Scripts and tests ----
# Base URL of a running server for `npm run smoke` and the HTTP proofs.
PROOF_BASE_URL="http://localhost:3120"
