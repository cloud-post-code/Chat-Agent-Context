{
  "name": "chat-agent-context",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install --with-deps chromium && NODE_OPTIONS=\"--require ./scripts/polyfill-file.cjs\" next build",
    "start": "node scripts/migrate.mjs && PLAYWRIGHT_BROWSERS_PATH=0 NODE_OPTIONS=\"--require ./scripts/polyfill-file.cjs\" next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "^6.1.0",
    "cheerio": "^1.0.0",
    "cytoscape": "3.34.0",
    "cytoscape-fcose": "2.2.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.21",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.62.1",
    "posthog-js": "^1.407.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cytoscape": "3.31.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^27.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20 <23"
  }
}