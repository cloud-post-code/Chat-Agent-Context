// Prisma schema for the multi-tenant agent-page platform.
// Production/Railway: Postgres. Applied via `prisma migrate deploy` (see
// scripts/migrate.mjs) — never `db push` against a real database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One account: the owner of exactly one public agent page and the admin
/// dashboard behind it. Every tenant model below hangs off this row (directly
/// or through its parent), so deleting a user removes their whole tenant.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Display name, shown in the directory and the admin header.
  name         String
  /// URL slug for the public agent page: /a/<slug>.
  slug         String   @unique
  /// scrypt hash, "salt:hex" (see lib/auth.ts). Empty = unclaimed founder
  /// account created by the migration; lib/bootstrap.ts fills it from env.
  passwordHash String
  /// Set when the guided onboarding flow completes (site-extracted or manual).
  /// Null routes the admin panel to /admin/onboarding. Pre-existing accounts
  /// are stamped by the migration so they never see the flow.
  onboardedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sources             Source[]
  chunks              Chunk[]
  entities            Entity[]
  edgeOrigins         EntityEdgeOrigin[]
  mergeDismissals     MergeDismissal[]
  photos              Photo[]
  projects            Project[]
  chatSessions        ChatSession[]
  cannedAnswers       CannedAnswer[]
  agentDirectives     AgentDirective[]
  uiCards             UiCard[]
  ingestionSources    IngestionSource[]
  itemClassifications ItemClassification[]
  addressBookEntries  AddressBookEntry[]
  gmailAuth           GmailAuth?
  contacts            Contact[]
  profile             Profile?
  personaConfig       PersonaConfig?
  themeConfig         ThemeConfig?
  a2aTasks            A2ATask[]
}

/// A unit of knowledge the chatbot can cite. Created from the unified
/// "extraction" ingest: a URL, an uploaded PDF, or pasted text/markdown.
model Source {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// link | pdf | text
  type      String   @default("link")
  /// For link sources; unique per user so re-adding the same URL updates it.
  url       String?
  /// Original filename for pdf/uploaded sources.
  filename  String?
  title     String?
  /// Cleaned full text extracted from the source.
  rawText   String? @db.Text
  /// Claude-generated summary used as chatbot knowledge.
  summary   String? @db.Text
  /// JSON array of tags, stored as a string.
  tags      String   @default("[]")
  /// linkedin | project | article | resume | note | other — content category.
  kind      String   @default("other")
  imageUrl  String?
  status    String   @default("pending") // pending | scanned | failed
  error     String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks    Chunk[]

  @@unique([userId, url])
  @@index([userId])
}

/// A passage of a Source's raw text, embedded for retrieval. Chunks are
/// rebuilt wholesale whenever their source is (re)indexed and cascade-delete
/// with it. Carries its own userId: chunks also derive from non-Source origins
/// (profile, persona, projects...), and retrieval scans them per tenant.
model Chunk {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  /// Which admin surface this chunk was derived from:
  /// source | profile | persona | project | photo | activity.
  /// Everything the admin curates feeds one index, not just Sources.
  originKind String   @default("source")
  /// Id of the origin row. The singletons use their kind as the id
  /// ("profile", "persona"); the rest use Project/Photo/ChatMessage/Source ids.
  originId   String   @default("")
  /// Human-readable label used when citing this chunk in the prompt.
  originLabel String  @default("")
  /// Set only for source-derived chunks, so they cascade with the Source.
  source     Source?  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String?
  /// 0-based position within the origin.
  seq        Int      @default(0)
  text       String @db.Text
  /// Float32Array bytes; null when embedding failed.
  embedding  Bytes?
  /// Which embedder produced `embedding`. Cosine only compares same-model
  /// vectors, so mixing providers over time degrades gracefully.
  embedModel String?
  createdAt  DateTime @default(now())
  mentions   EntityMention[]

  @@index([sourceId])
  @@index([userId, originKind, originId])
}

/// A named thing the knowledge base talks about (person, org, project, ...).
/// `key` is the normalized lookup form (lowercased, single-spaced), unique
/// per user so tenants' graphs never merge.
model Entity {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  key       String
  /// person | org | project | skill | place | topic | event | other
  type      String   @default("topic")
  createdAt DateTime @default(now())
  mentions  EntityMention[]
  edgesOut  EntityEdge[] @relation("EdgeFrom")
  edgesIn   EntityEdge[] @relation("EdgeTo")

  @@unique([userId, key])
}

/// Which chunks mention which entities. Used to hop from retrieved text to
/// the graph and back. Scoped through both parents.
model EntityMention {
  id       String @id @default(cuid())
  chunk    Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  chunkId  String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String

  @@unique([chunkId, entityId])
  @@index([entityId])
}

/// A directed, labeled relation between two entities ("Zephyrwind —developed
/// at→ Aeolus Labs"). Powers one-hop expansion at retrieval time. Scoped
/// through its endpoints (both always belong to one user).
model EntityEdge {
  id       String @id @default(cuid())
  from     Entity @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromId   String
  to       Entity @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  toId     String
  relation String
  origins  EntityEdgeOrigin[]

  @@unique([fromId, toId, relation])
  @@index([toId])
}

/// Which origin asserted an edge. Edges are deduped across origins, so a
/// relation two surfaces both state is owned by both and only disappears when
/// the last owner is deleted or stops asserting it.
///
/// An edge with NO rows here is never auto-pruned: that covers relations added
/// by hand on the Graph tab and every edge written before provenance existed.
/// Only an edge whose ownership was recorded and then fully retracted is
/// deleted, so adding this table can't silently empty an existing graph.
///
/// Carries userId directly: origin ids like "profile" repeat across tenants,
/// so lookups by (originKind, originId) must be scoped here.
model EntityEdgeOrigin {
  id         String     @id @default(cuid())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  edge       EntityEdge @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  edgeId     String
  /// Matches Chunk.originKind / Chunk.originId.
  originKind String
  originId   String

  @@unique([edgeId, originKind, originId])
  @@index([userId, originKind, originId])
}

/// A suggested-merge pair the admin rejected with "Don't merge". Keyed by the
/// two entities' normalized keys, sorted (keyA < keyB), not their ids: entity
/// rows get pruned and recreated as sources are re-indexed, and the judgment
/// that two *names* are different things must survive that.
model MergeDismissal {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  keyA      String
  keyB      String
  createdAt DateTime @default(now())

  @@unique([userId, keyA, keyB])
}

/// An uploaded photo. On upload we ask Claude vision for a one-paragraph
/// description; it's editable afterward. Exposed individually or in galleries.
model Photo {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// Stored filename on the upload volume.
  filename    String
  /// One-paragraph AI (or manual) description.
  description String   @default("") @db.Text
  caption     String?
  /// gallery | project | profile
  kind        String   @default("gallery")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// A curated project. Each has up to two links: a GitHub repo and a live URL.
model Project {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  blurb       String @db.Text
  /// Longer AI-enriched write-up, shown when a card's "Learn more" expands.
  detail      String? @db.Text
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  /// JSON array of tags, stored as a string.
  tags        String   @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

/// A single visitor conversation with one user's chatbot. One row per browser
/// session (the client sends a stable sessionId); messages hang off it so the
/// admin "Activity" tab can replay what people are asking.
model ChatSession {
  id         String        @id @default(cuid())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  /// Stable id generated client-side and reused across a visitor's turns.
  /// Unique per user: the same browser can talk to two agent pages.
  visitorKey String
  /// First user question — a quick label for the conversation list.
  firstQuery String        @default("") @db.Text
  messages   ChatMessage[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, visitorKey])
}

/// One message inside a ChatSession: either the visitor's question or the
/// bot's answer. Text only — rendered cards aren't stored. Scoped through the
/// session.
model ChatMessage {
  id        String      @id @default(cuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  /// user | assistant
  role      String
  content   String @db.Text
  createdAt DateTime    @default(now())

  // ── Admin feedback (set from the Activity tab, only on assistant messages) ──
  /// null = unrated, "up" = good answer, "down" = bad answer.
  rating    String?
  /// The owner's correction: what the bot should have done instead. When set
  /// on a "down"-rated message, it's injected into future system prompts.
  note      String? @db.Text

  @@index([sessionId])
}

/// A hand-written answer to a question visitors ask over and over — the
/// starter chips, mostly. When an incoming message normalizes to `matchKey`,
/// the chatbot serves `answer` directly and never calls the model. Written and
/// edited on the admin "Answers" tab; a blank `answer` is a to-do, not a
/// response, so the question falls through to the model until it's filled in.
model CannedAnswer {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// The question as written, shown in the admin list.
  question  String @db.Text
  /// `question` run through normalizeQuestion() — the actual lookup key.
  matchKey  String
  /// The answer text. Empty means "not written yet": falls through to the model.
  answer    String   @default("") @db.Text
  /// True while `answer` is a model-written draft the owner hasn't reviewed. A
  /// draft is served exactly like a hand-written answer — it comes from the
  /// same retrieval + persona prompt the chatbot would have used — so this is
  /// an admin-facing distinction only: it drives the "unreviewed" marker and is
  /// cleared the moment the owner saves the row.
  aiDraft   Boolean  @default(false)
  /// When a draft was last generated for this row. Non-null means the automatic
  /// pass has already spent its one shot here and must never fire again — so a
  /// row the owner deliberately empties stays empty instead of refilling itself.
  draftedAt DateTime?
  /// Optional card to render alongside the answer, named by the tool that
  /// would have drawn it: show_projects | show_project | show_gallery |
  /// show_contact_form. Hydrated through the same path the model path uses.
  cardTool  String?
  /// JSON args for `cardTool`, e.g. {"id":"..."} or {"layout":"filmstrip"}.
  cardInput String?
  /// Off without losing the text.
  enabled   Boolean  @default(true)
  /// Times served — the running count of model calls this row has avoided.
  hits      Int      @default(0)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchKey])
}

/// One behavioral directive for the chatbot, written on the admin Agent
/// Behavior tabs. `kind` is "goal" (an outcome to steer conversations toward)
/// or "rule" (a hard constraint the bot must follow). Enabled rows are
/// rendered into the system prompt by lib/directives.ts; disabled rows keep
/// their text but are invisible to the prompt.
model AgentDirective {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// "goal" | "rule" — which Agent Behavior tab owns the row.
  kind      String
  text      String   @db.Text
  /// Off without losing the text.
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

/// One A2UI card the admin curates: what it's called, which tool draws it,
/// when the agent should reach for it, and a stored sample payload the admin
/// tab renders as a preview. The starter set is seeded per user at signup;
/// after that the rows are the owner's to edit, add to, or delete —
/// re-seeding would resurrect deliberate deletions.
model UiCard {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// Stable slug ("gallery-carousel") — the anchor id on the admin tab.
  key         String
  /// Human name shown as the card's heading ("Gallery — carousel").
  label       String
  /// The A2UI tool that draws it: show_projects | show_project | show_gallery
  /// | show_timeline | show_contact_form | show_booking | show_booking_link.
  tool        String
  /// One line on what the card renders, shown next to the tool name.
  description String   @default("") @db.Text
  /// When the agent should show this card — the guidance text for this tool.
  reason      String   @default("") @db.Text
  /// Admin-facing caveat ("live card — reads your actual calendar"), if any.
  note        String   @default("") @db.Text
  /// JSON UiBlock (lib/cards.ts shape) the preview renders — the card's
  /// structure with sample content, not live site data.
  sampleBlock String   @default("{}") @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, key])
}

/// One admin ingestion source: a Content tab the dashboard renders, stored as
/// data the way A2UI cards are. The row holds the source's code (key), how
/// content gets in (uploadMethod), the uniform storage rule (storageKinds:
/// every ingested piece is text or image), where it lands (outputMethod), and
/// its own system prompt. The seven built-in tabs are seeded per user at
/// signup; after that the rows are the owner's — re-seeding would resurrect
/// deliberate deletions.
model IngestionSource {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  /// Stable slug ("experience") — the source's code, used for deep links
  /// and panel dispatch.
  key          String
  /// Human name shown on the tab ("Experience").
  label        String
  /// One line on what this source ingests.
  description  String   @default("") @db.Text
  /// This source's own system prompt: extraction/guidance text applied to
  /// content ingested through it.
  systemPrompt String   @default("") @db.Text
  /// How content gets in: resume | github | url | file | textarea | image |
  /// form | generic.
  uploadMethod String
  /// The uniform storage rule: "text" | "image" | "text+image".
  storageKinds String   @default("text")
  /// "split" (default): every text ingest splits into one item per point.
  /// "single": each upload stays one item — no split model call.
  splitMode    String   @default("split")
  /// Optional custom HTML+inline-CSS for this source's Content tab, with a
  /// {{items}} placeholder — validated like coded cards (safeCardHtml) and
  /// rendered in the same sealed iframe. "" means the default page.
  panelHtml    String   @default("") @db.Text
  /// Who this source's content is for: "public" | "contact" |
  /// "close-friends" | "personal". This is the DEFAULT applied to everything
  /// ingested through the source; a single document can override it at ingest
  /// time (see ItemClassification). The frontend still shows everything to
  /// everyone — classification is recorded, not yet enforced at retrieval.
  classification String @default("public")
  /// Where ingested data lands (which model/store), recorded as data so the
  /// dashboard can show it ("Source + Chunk rows", "Photo + upload dir", …).
  outputMethod String   @default("") @db.Text
  /// Seeded tabs render their bespoke panels; custom rows the generic panel.
  builtin      Boolean  @default(true)
  enabled      Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, key])
}

/// A per-item override of its ingestion source's classification: "this one
/// document is Personal even though the source defaults to Public".
///
/// Keyed by `itemId` — the composite "<model>:<rowid>" id that
/// lib/ingestedItems.ts already assigns every ingested item ("source:<cuid>",
/// "photo:<cuid>", "experience:3", "persona:voice") — unique per user, since
/// non-cuid item ids repeat across tenants.
///
/// Absence of a row means "inherit the source's classification" — the default
/// is never copied down, so re-classifying a source moves every item that
/// hasn't been deliberately overridden.
model ItemClassification {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  /// "<model>:<rowid>", matching IngestedItem.id.
  itemId         String
  /// Which source ingested the item, so a source's overrides can be swept
  /// when its data is deleted.
  sourceKey      String
  /// public | contact | close-friends | personal.
  classification String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([userId, sourceKey])
}

/// One person in the owner's address book, curated on the Agent Behavior →
/// Contacts tab. Distinct from `Contact` (in-chat form submissions): these are
/// people the owner adds by hand, each reachable by email or phone and
/// carrying a trust tier that mirrors the ingestion classifications
/// (public | co-worker | close-friend | personal).
model AddressBookEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  /// Free-text notes about the person.
  details   String   @default("") @db.Text
  /// Email address; optional but at least one of email/phone is expected.
  email     String   @default("")
  /// Phone number; optional but at least one of email/phone is expected.
  phone     String   @default("")
  /// Trust tier: public | co-worker | close-friend | personal.
  trust     String   @default("public")
  order     Int      @default(0)
  /// Identity key for sent-mail ingestion: the email lowercased, with dots and
  /// +tags folded ONLY for gmail.com/googlemail.com. Unique per user, so a
  /// re-sync enriches the existing person instead of adding a second row.
  /// Empty for hand-added contacts with no email — "" would collide under the
  /// unique, so those store null.
  canonicalEmail String?
  /// How this contact arrived: manual | gmail.
  source         String  @default("manual")
  /// Sent messages seen for this person; accumulates across syncs.
  messageCount   Int     @default(0)
  firstContacted DateTime?
  lastContacted  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, canonicalEmail])
}

/// The stored Gmail authorization — one row per user.
///
/// The refresh token lives here rather than in an env var so re-consent after
/// a revoked or expired grant is a button in the dashboard instead of a
/// redeploy. Deliberately separate from the calendar credentials in env:
/// Google issues one refresh token per OAuth client covering every consented
/// scope, so a shared client would let a Gmail re-consent replace the token
/// the booking flow depends on.
model GmailAuth {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @unique
  refreshToken String    @db.Text
  /// The mailbox that granted access, for display in the admin panel.
  emailAddress String    @default("")
  /// Scopes actually granted, so a narrowed grant is visible rather than
  /// surfacing later as a confusing API error.
  scope        String    @default("") @db.Text
  /// Incremental sync cursor: messages newer than this were already read.
  /// Null means nothing has synced yet, and the next sync reads everything.
  /// Advanced only after a fully successful pass, so a mid-sync failure
  /// re-reads a window rather than silently skipping it.
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A contact submission captured by the in-chat A2UI contact form.
model Contact {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  email     String
  message   String @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One user's editable business identity. What the chatbot states as fact
/// about the business lives here; brand voice is PersonaConfig and the site's
/// look is ThemeConfig.
model Profile {
  id                   Int      @id @default(autoincrement())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String   @unique
  company_name         String   @default("")
  owner_name           String   @default("")
  company_address      String   @default("")
  company_phone_number String   @default("")
  company_email        String   @default("")
  /// Free text, e.g. "Mon-Fri 9am-5pm ET".
  company_hours        String   @default("")
  updatedAt            DateTime @updatedAt
}

/// Brand voice: what one user's chatbot sounds like and the face it shows.
model PersonaConfig {
  id           Int     @id @default(autoincrement())
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String  @unique
  /// /api/uploads/<file> — shown where the site needs a brand image.
  company_logo String?
  tagline      String  @default("")
  /// JSON {sectionKey: text} for the persona sections catalogued in
  /// lib/persona.ts. This is the persona the chatbot speaks from.
  personaSections String @default("{}") @db.Text
  updatedAt    DateTime @updatedAt
}

/// Theme (drives one user's agent page CSS variables), edited on the Theme tab.
model ThemeConfig {
  id            Int    @id @default(autoincrement())
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String @unique
  /// Curated heading font key (see lib/fonts).
  themeFont     String @default("space-grotesk")
  /// Curated body/text font key (see lib/fonts).
  themeBodyFont String @default("inter")
  /// JSON {bg, surface, border, text, textMuted, primary, accent} hex overrides.
  themeColors   String @default("{}")
  /// Corner roundness preset: sharp | rounded | pill.
  themeRadius   String @default("rounded")
  /// Base font size in px (body text scale). Empty = default 16.
  themeFontSize String @default("")
  /// Heading font weight: 500 | 600 | 700 | 800. Empty = default.
  themeHeadingWeight String @default("")
  /// Free-text description of the visual feeling.
  aesthetic     String @default("") @db.Text
  updatedAt     DateTime @updatedAt
}

/// An agent-to-agent task. The legacy A2A endpoint serves the founding user's
/// agent; tasks are scoped so a future per-slug A2A surface slots in.
model A2ATask {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Groups tasks into one conversation. Reused as the chat sessionId, so an
  /// agent-to-agent conversation shows up in Activity like any visitor's.
  contextId String
  /// TaskState in short form: submitted | working | completed | failed |
  /// canceled | rejected. Rendered to the wire spelling per protocol version.
  state     String   @default("submitted")
  /// JSON array of A2A Message objects (v1.0 shape) — the turn history.
  history   String   @default("[]") @db.Text
  /// JSON array of A2A Artifact objects (v1.0 shape) — the answer and any
  /// UI cards the brain emitted, as structured data parts.
  artifacts String   @default("[]") @db.Text
  /// Human-readable reason the task ended in `failed`.
  error     String?  @db.Text
  /// Set by CancelTask. The runner checks it between brain events, which is
  /// the only safe place to stop — mid-stream there is nothing to roll back.
  cancelRequested Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contextId])
  @@index([state])
  @@index([createdAt])
  @@index([userId])
}
